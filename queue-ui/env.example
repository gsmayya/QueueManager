NEXT_PUBLIC_API_BASE_URL=/api

# Next.js server-side proxy target for `/api/*` rewrites.
# Local dev default: http://localhost:8080
# Docker Compose default (service name): http://api:8080
API_PROXY_TARGET=http://localhost:8080

# Next.js server-side proxy target for `/master-api/*` rewrites.
# Local dev default: http://localhost:8081
# Docker Compose default (service name): http://master-service:8081
MASTER_API_PROXY_TARGET=http://localhost:8081

# Secret used by the UI to sign the auth session cookie (HMAC).
# Generate your own for real deployments.
AUTH_SECRET=change-me

